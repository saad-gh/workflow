# =================================================================
# Workflow Orchestrator Environment Variables
# Copy this file to .env and configure as needed.
# =================================================================

# Django Settings
SECRET_KEY=your-django-secret-key-here
DEBUG=True
TESTING=False
ALLOWED_HOSTS=*

# Database Settings (PostgreSQL or SQLite depending on host settings)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=workflow_orchestrator_db
DB_USER=postgres
DB_PASS=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis / RQ Queues Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_AUTH=

# Swappable Model Target Overrides (Optional)
TASK_ORGANIZATION_MODEL=workflow_orchestrator.Organization
TASK_CREDENTIAL_MODEL=workflow_orchestrator.Credential
TASK_SERVICE_MODEL=workflow_orchestrator.Service
TASK_RESOURCE_MODEL=workflow_orchestrator.Resource

# Webhook
BASE_URL=http://localhost:8000
WEBHOOK_BASE_URL=http://localhost:8000
